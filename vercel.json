{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "prisma migrate deploy && prisma generate && next build",
  "devCommand": "next dev",
  "outputDirectory": ".next",
  "regions": ["bom1"],
  "functions": {
    "app/api/health/route.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "app/api/lots/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "app/api/lots/[id]/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "app/api/bids/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "app/api/bids/[id]/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "app/api/orders/[id]/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "app/api/deals/[id]/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "app/api/deals/[id]/messages/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "app/api/deals/[id]/counter-offer/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "app/api/deals/[id]/accept/route.ts": {
      "memory": 1024,
      "maxDuration": 20
    },
    "app/api/auth/[...nextauth]/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    },
    "app/api/auth/register/route.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
