# ---- KasetHub environment -----------------------------------------------
# Copy to .env.local for local dev, and set the same vars in Vercel project settings.

# Supabase -> Project Settings -> Database -> Connection string
# Two different strings, and the difference is not cosmetic.
#
#   DATABASE_URL  Transaction pooler, port 6543. Used at runtime by the app.
#                 `pgbouncer=true` tells Prisma to skip prepared statements,
#                 which PgBouncer's transaction mode cannot hold across a
#                 connection hand-off. `connection_limit=1` because every
#                 serverless instance brings its own pool and Supabase's
#                 connection budget is shared across all of them.
#   DIRECT_URL    Session pooler, port 5432. Read by `prisma generate` and
#                 `prisma migrate deploy` through `directUrl` in the schema.
#                 Transaction mode does not support the advisory locks Prisma
#                 takes while migrating, so migrating through 6543 fails.
#
# For local dev either port works; 5432 avoids the transaction-pooling caveats.
#
# connection_limit / pool_timeout are not optional in practice. Left to itself
# Prisma sizes the pool at (2 x CPU count) + 1, which on a 2-core box is 5
# connections — and a single rendered page opens several at once (session, lot,
# bids, ticker, alert count). That pool ran dry under ordinary browsing and
# surfaced as Prisma P2024 "Timed out fetching a new connection", i.e. a 500
# from a healthy database. pool_timeout widens the queue so a burst waits
# instead of failing.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-APAC-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-APAC-REGION.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=20"

# Public site URL, used for absolute links / metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- NextAuth (required for /login, /register and every guarded route) ----
# Sessions are JWTs, so this secret signs the session cookie and nothing works
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"
# The canonical origin next-auth builds callback URLs from. In production this
# must match the deployed domain or the sign-in redirect loop never settles.
NEXTAUTH_URL="http://localhost:3000"

# ---- Supabase Storage (optional) -------------------------------------------
# Chat photo attachments go to Storage when both values are present. Without
# them the server falls back to keeping a downscaled inline image on the
# message row (capped at 700 KB) — fine for development, not for production.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="chat-attachments"
